# Fuente de datos del frontend.
#   mock -> motor determinista en el navegador (sin backend), poblado con
#           los 8 escenarios de backend/app/data/sample_requests.json.
#           Es el valor por defecto: permite demostrar la UI sin depender
#           de que app/api/ este corriendo (mismo principio que LLM_MODE=fake
#           en el backend).
#   http -> llama a la API real via VITE_API_BASE_URL.
VITE_API_MODE=mock

# Solo se usa cuando VITE_API_MODE=http.
VITE_API_BASE_URL=http://localhost:8000

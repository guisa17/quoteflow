# QuoteFlow — plantilla de configuracion.
# Copiar a .env y completar. NUNCA versionar .env (ver .gitignore).

# --- Base de datos / checkpointer LangGraph (RNF-01) -------------------------
# Debe apuntar al Postgres levantado por docker-compose.yml
DATABASE_URL=postgresql://quoteflow:quoteflow@localhost:5432/quoteflow

# --- Modo de LLM (RF-10) ------------------------------------------------------
# fake -> extractor determinista, sin red. Es el modo por defecto de los tests.
# real -> llama al proveedor configurado abajo. Si el proveedor no responde
#         (sin key, cuota agotada, 5xx), se usa el extractor de reglas y la
#         auditoria del folio lo indica.
LLM_MODE=fake

# --- Proveedor LLM (solo necesario si LLM_MODE=real) -------------------------
LLM_PROVIDER=gemini
# Key gratuita en https://aistudio.google.com
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
LLM_TIMEOUT_SECONDS=20

# Reservado para un extractor de Anthropic (aun no implementado).
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5

# --- Aplicacion ---------------------------------------------------------------
APP_ENV=local
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173

# QuoteFlow — plantilla de configuracion.
# Copiar a .env y completar. NUNCA versionar .env (ver .gitignore).

# --- Base de datos / checkpointer LangGraph (RNF-01) -------------------------
# Debe apuntar al Postgres levantado por docker-compose.yml
DATABASE_URL=postgresql://quoteflow:quoteflow@localhost:5432/quoteflow

# --- Modo de LLM (RF-10) ------------------------------------------------------
# fake -> extractor determinista, sin red. Es el modo por defecto de los tests.
# real -> llama al proveedor configurado abajo. Si el proveedor no responde
#         (sin key, cuota agotada, 5xx), se usa el extractor de reglas y la
#         auditoria del folio lo indica.
LLM_MODE=fake

# --- Proveedor LLM (solo necesario si LLM_MODE=real, ver ADR-006) ------------
# LLM_MODEL=proveedor:modelo. Vacio = Gemini con GEMINI_MODEL.
#   gemini:gemini-3.5-flash-lite      Gemini por REST, sin paquetes extra (por defecto)
#   anthropic:claude-haiku-5-5        cd backend && uv sync --extra anthropic
#   openai:gpt-5-mini                 cd backend && uv sync --extra openai
#   google_genai:gemini-3.5-flash-lite  Gemini via LangChain (uv sync --extra google)
#   ollama:llama3.2                   modelo local, sin key (uv sync --extra ollama)
# Otros proveedores de LangChain (mistralai, groq, deepseek, bedrock...) se
# instalan con `uv add langchain-<proveedor>`.
LLM_MODEL=
# Key del proveedor elegido. Con Gemini tambien sirve GEMINI_API_KEY.
LLM_API_KEY=
# Servidor compatible con la API de OpenAI (OpenRouter, vLLM, LM Studio...)
# con LLM_MODEL=openai:<modelo>, o la URL de un Ollama remoto.
LLM_BASE_URL=
# Fuerza el mecanismo de salida estructurada si el servidor no soporta el
# que elige LangChain: json_schema, function_calling o json_mode.
LLM_STRUCTURED_OUTPUT=
LLM_TIMEOUT_SECONDS=20

# Gemini: key gratuita en https://aistudio.google.com
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# --- Trazas en LangSmith (opcional) -------------------------------------------
# Registra cada solicitud nodo a nodo, con la llamada al LLM, tokens y latencia.
# Con las trazas activas, el texto del cliente se envia a LangSmith.
# Key en https://smith.langchain.com (Settings -> API Keys). Las pruebas nunca
# envian trazas, aunque esto este activo.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=quoteflow
# LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com   # solo si la cuenta es de la region UE

# --- Aplicacion ---------------------------------------------------------------
APP_ENV=local
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173
